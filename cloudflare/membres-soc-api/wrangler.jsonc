{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "frj-membres-soc-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "PUBLIC_SITE_ORIGIN": "https://mrln033.github.io",
    "RULES_ACCEPTED_ROLE_ID": "1189173135380058133",
    "GAS_SYNC_URL": "https://script.google.com/macros/s/AKfycbzf40jOrUs79_O5PASuc7Y-OOZv_C2RZV1bY7r97WhF8iVVQ6f4nIpBCCRh_0IOIozSew/exec",
    "SYNC_MODE": "active"
  },
  "queues": {
    "producers": [
      {
        "binding": "SYNC_QUEUE",
        "queue": "frj-membres-sync"
      }
    ],
    "consumers": [
      {
        "queue": "frj-membres-sync",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "frj-membres-sync-dlq"
      }
    ]
  },
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "services": [
    {
      "binding": "DISCORD_PROXY",
      "service": "discord-proxy"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "frj-membres-soc",
      "database_id": "09b3c024-99f9-4add-a12c-ed214a462df5",
      "preview_database_id": "local",
      "migrations_dir": "migrations"
    }
  ]
}
