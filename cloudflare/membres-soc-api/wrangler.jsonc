{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "frj-membres-soc-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "PUBLIC_SITE_ORIGIN": "https://mrln033.github.io",
    // Garde de déploiement : passer à "discord" seulement après avoir posé les
    // secrets OAuth/session et publié la nouvelle version GAS.
    "ADMIN_AUTH_MODE": "discord",
    // Garde de déploiement : conserver admin_only jusqu'à publication conjointe
    // du nouveau frontend, puis passer explicitement à guild_members.
    "AUTH_LOGIN_POLICY": "admin_only",
    // À laisser vrai uniquement durant le chevauchement ancien/nouveau frontend.
    "ALLOW_LEGACY_ADMIN_TOKEN": "true",
    // Identifiant public de l'application Discord utilisée pour OAuth.
    "DISCORD_OAUTH_CLIENT_ID": "1479825051522957462",
    "DISCORD_OAUTH_REDIRECT_URI": "https://frj-membres-soc-api.merlin-merzhin-lesage.workers.dev/auth/discord/callback",
    "RULES_ACCEPTED_ROLE_ID": "1189173135380058133",
    "GAS_SYNC_URL": "https://script.google.com/macros/s/AKfycbzf40jOrUs79_O5PASuc7Y-OOZv_C2RZV1bY7r97WhF8iVVQ6f4nIpBCCRh_0IOIozSew/exec",
    "SYNC_MODE": "active",
    // D-002 reste sans effet en production tant que la migration, GAS et la
    // recette ne sont pas terminés. Activation explicite en deux temps.
    "DISCORD_ROLE_SYNC_MODE": "off",
    "DISCORD_ROLE_DISPLAY_ENABLED": "false"
  },
  "queues": {
    "producers": [
      {
        "binding": "SYNC_QUEUE",
        "queue": "frj-membres-sync"
      },
      {
        "binding": "DISCORD_ROLE_QUEUE",
        "queue": "frj-discord-role-sync"
      }
    ],
    "consumers": [
      {
        "queue": "frj-membres-sync",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "frj-membres-sync-dlq"
      },
      {
        "queue": "frj-discord-role-sync",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "max_concurrency": 1,
        "dead_letter_queue": "frj-discord-role-sync-dlq"
      }
    ]
  },
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "services": [
    {
      "binding": "DISCORD_PROXY",
      "service": "discord-proxy"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "frj-membres-soc",
      "database_id": "09b3c024-99f9-4add-a12c-ed214a462df5",
      "preview_database_id": "local",
      "migrations_dir": "migrations"
    }
  ]
}
